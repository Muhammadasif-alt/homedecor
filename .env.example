# Copy to .env and fill in. Never commit .env.
# Production (Hostinger) values are shown; for local development use APP_ENV=local, APP_DEBUG=true.

APP_NAME="Home Decor Studio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Hostinger MySQL (hPanel → Databases). Host is usually localhost on shared hosting.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Mail is sent synchronously — no long-running queue worker needed on shared hosting.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Hostinger email: create a mailbox in hPanel → Emails, then use its credentials.
# Until configured, MAIL_MAILER=log keeps leads safe (they are always stored in the database).
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Used once by `php artisan db:seed --class=AdminUserSeeder` to create the first admin. Remove afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
